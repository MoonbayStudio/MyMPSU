# MyMPSU configuration
# Copy this file to .env, fill in the required values, then run `make up`.
# Never commit .env. Empty optional values disable or skip that integration.

# -----------------------------------------------------------------------------
# PostgreSQL (required)
# -----------------------------------------------------------------------------
POSTGRES_DB=mympsu
POSTGRES_USER=mympsu
DATABASE_PASSWORD=replace-with-a-long-random-password

# Docker Compose overrides this with the connection to its `db` service. Set it
# yourself only when the API is started outside Compose.
DATABASE_URL=

# -----------------------------------------------------------------------------
# API and security (required)
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-different-random-64-character-value

# 127.0.0.1 is recommended when Caddy/nginx runs on the same server.
# Use 0.0.0.0 only if port 8000 must be reachable directly.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

# Public address of the website and browser origins allowed to call the API.
# Multiple CORS origins are separated by commas, without a trailing slash.
FRONTEND_BASE_URL=https://mympsu.example.org
CORS_ORIGINS=https://mympsu.example.org,http://localhost:8080

# Initial operators. These values do not create accounts. After normal sign-in,
# a matching email receives owner/admin privileges.
OWNER_EMAILS=owner@example.org
ADMIN_EMAILS=admin@example.org

# -----------------------------------------------------------------------------
# Legacy schedule adapter — MPGU implementation required; see docs/MYMPSU_SETUP.md
# -----------------------------------------------------------------------------
MPGU_SCHEDULE_API_BASE_URL=
MPGU_SCHEDULE_API_PATH=/schedule/v1/schedule

# -----------------------------------------------------------------------------
# Apple and Google sign-in (optional)
# -----------------------------------------------------------------------------
APPLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# -----------------------------------------------------------------------------
# AI assistant (optional)
# -----------------------------------------------------------------------------
# Recommended first setup: create an OpenRouter key, enable the assistant and
# keep openrouter/free until you decide on a specific free model. The key stays
# on the API server and is never shipped to iOS, Android, web or desktop apps.
ENABLE_AI_AGENT=false
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://mympsu.example.org
OPENROUTER_APP_NAME=MyMPSU

# Ollama remains available for a fully local setup. Set AI_PROVIDER=ollama.
# If Ollama runs on the Docker host, this address works with the supplied
# Compose file on macOS, Windows and Linux.
OLLAMA_BASE_URL=http://host.docker.internal:11434
PELIKASHA_MODEL=pelikasha:latest

# default, auto, exams, christmas, finals, halloween or back_to_school
PERSONA_THEME=default

# -----------------------------------------------------------------------------
# SMTP email (optional, needed for verification and password recovery)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MyMPSU
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30
SMTP_FALLBACK_PORTS=587
EMAIL_LOGO_URL=https://mympsu.example.org/img/logo.png

# -----------------------------------------------------------------------------
# Feature switches
# -----------------------------------------------------------------------------
ENABLE_HOMEWORK_MODULE=true
ENABLE_ROLE_REQUESTS_MODULE=true
ENABLE_ADMIN_ROLE_MANAGEMENT_MODULE=true

# -----------------------------------------------------------------------------
# Apple App Attest / Google Play Integrity (advanced and optional)
# -----------------------------------------------------------------------------
APP_INTEGRITY_ENFORCE_ASSISTANT=false
APP_INTEGRITY_CHALLENGE_TTL_SECONDS=300
APP_INTEGRITY_IOS_TEAM_ID=
APP_INTEGRITY_IOS_BUNDLE_ID=
APP_INTEGRITY_IOS_APP_ID=
APP_INTEGRITY_APPLE_ROOT_CA_URL=https://www.apple.com/certificateauthority/Apple_App_Attestation_Root_CA.pem
APP_INTEGRITY_APPLE_ROOT_CA_PEM=
APP_INTEGRITY_ANDROID_PACKAGE_NAME=
APP_INTEGRITY_ANDROID_ALLOWED_APP_VERDICTS=PLAY_RECOGNIZED
APP_INTEGRITY_ANDROID_ALLOWED_DEVICE_VERDICTS=MEETS_DEVICE_INTEGRITY,MEETS_STRONG_INTEGRITY
APP_INTEGRITY_ANDROID_REQUIRE_LICENSED=false

# Prefer a compact, one-line JSON value in Compose. A file path works only when
# that file is also mounted into the API container.
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_FILE=
