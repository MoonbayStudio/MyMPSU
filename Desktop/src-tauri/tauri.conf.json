{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Мой МПГУ",
  "version": "0.1.0",
  "identifier": "ru.moonbaystudio.mympsu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https://api.mympsu.moonbaystudio.ru http://127.0.0.1:8000; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["desktop"]
    },
    "windows": [
      {
        "label": "main",
        "title": "Мой МПГУ",
        "width": 1200,
        "height": 800,
        "minWidth": 850,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Visible"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/Assets.car",
      "icons/AppIcon.icon",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Расписание и учебные дела МПГУ",
    "longDescription": "Desktop-клиент Мой МПГУ для расписания, домашних заданий и профиля.",
    "createUpdaterArtifacts": false,
    "linux": { "deb": { "depends": [] } },
    "macOS": { "minimumSystemVersion": "10.15" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
